{
  "name": "@orchajs/playground-ui",
  "version": "0.2.1",
  "description": "Shared Orcha playground React UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amarsia/orcha.git",
    "directory": "packages/playground-ui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js"
    },
    "./orcha-logo.svg": "./dist/orcha-logo.svg"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/orcha-logo.svg', 'dist/orcha-logo.svg')\"",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "baseui": "^16.1.1",
    "react-markdown": "^10.1.0",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1"
  }
}
