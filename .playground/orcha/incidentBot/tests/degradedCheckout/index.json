{
  "description": "Uses service telemetry to assess a checkout incident.",
  "input": {
    "content": "Checkout requests are slow. Check the checkout-api service and summarize the incident."
  },
  "actions": {
    "lookup_service_health": {
      "responses": [
        {
          "output": {
            "service": "checkout-api",
            "status": "degraded",
            "p95LatencyMs": 1840,
            "errorRate": 0.073,
            "lastDeployment": "2026-09-12T16:20:00Z"
          }
        }
      ]
    }
  },
  "expect": {
    "status": "completed",
    "text": {
      "contains": ["degraded"]
    },
    "actions": [
      {
        "name": "lookup_service_health",
        "arguments": {
          "equals": {
            "service": "checkout-api"
          }
        }
      }
    ]
  }
}
