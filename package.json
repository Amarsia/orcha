{
  "name": "orchajs",
  "version": "0.1.0-next.4",
  "description": "A filesystem-convention, stateful agent framework for JavaScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amarsia/orcha.git"
  },
  "homepage": "https://orcha.sh",
  "bugs": {
    "url": "https://github.com/Amarsia/orcha/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/integrations/esbuild.d.ts",
      "import": "./dist/integrations/esbuild.js"
    }
  },
  "bin": {
    "orcha": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && npm run test:runtime",
    "test:runtime": "node --test tests/*.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "esbuild": "^0.25.9",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  }
}
