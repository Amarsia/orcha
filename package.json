{
  "name": "orchajs",
  "version": "0.23.6",
  "description": "A filesystem-convention, stateful agent framework for JavaScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amarsia/orcha.git"
  },
  "homepage": "https://orcha.sh",
  "bugs": {
    "url": "https://github.com/Amarsia/orcha/issues"
  },
  "workspaces": [
    ".",
    "packages/create-orcha",
    "packages/playground-ui"
  ],
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native.js",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./esbuild": {
      "types": "./dist/integrations/esbuild.d.ts",
      "import": "./dist/integrations/esbuild.js",
      "require": "./dist-cjs/integrations/esbuild.js"
    },
    "./serverless": {
      "types": "./dist/integrations/serverless.d.ts",
      "import": "./dist/integrations/serverless.js",
      "require": "./dist-cjs/integrations/serverless.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist-cjs/testing.js"
    },
    "./vite": {
      "types": "./dist/integrations/vite.d.ts",
      "import": "./dist/integrations/vite.js",
      "require": "./dist-cjs/integrations/vite.js"
    },
    "./webpack": {
      "types": "./dist/integrations/webpack.d.ts",
      "import": "./dist/integrations/webpack.js",
      "require": "./dist-cjs/integrations/webpack.js"
    },
    "./next": {
      "types": "./dist/integrations/next.d.ts",
      "import": "./dist/integrations/next.js",
      "require": "./dist-cjs/integrations/next.js"
    },
    "./metro": {
      "types": "./dist/integrations/metro.d.ts",
      "import": "./dist/integrations/metro.js",
      "require": "./dist-cjs/integrations/metro.js"
    },
    "./expo": {
      "types": "./dist/integrations/expo.d.ts",
      "import": "./dist/integrations/expo.js",
      "require": "./dist-cjs/integrations/expo.js"
    }
  },
  "typesVersions": {
    "*": {
      "esbuild": [
        "dist/integrations/esbuild.d.ts"
      ],
      "serverless": [
        "dist/integrations/serverless.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "vite": [
        "dist/integrations/vite.d.ts"
      ],
      "webpack": [
        "dist/integrations/webpack.d.ts"
      ],
      "next": [
        "dist/integrations/next.d.ts"
      ],
      "metro": [
        "dist/integrations/metro.d.ts"
      ],
      "expo": [
        "dist/integrations/expo.d.ts"
      ]
    }
  },
  "bin": {
    "orcha": "dist/bin.js"
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run build --workspace=@orchajs/playground-ui && tsc -p tsconfig.json && node scripts/build-cjs.mjs && tsc -p tsconfig.playground.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && npm run test:runtime && npm run test:create-orcha",
    "test:runtime": "node --test tests/*.test.mjs",
    "test:create-orcha": "npm test --workspace=create-orcha",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "pack:check": "npm pack --dry-run && npm pack --dry-run --workspace=@orchajs/playground-ui",
    "size:check": "node scripts/check-package-size.mjs",
    "verify:production": "node scripts/verify-production-integration.mjs .playground .playground/dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "peerDependencies": {
    "@orchajs/playground-ui": ">=0.2.4",
    "@react-native-async-storage/async-storage": ">=2 <3",
    "@aws-sdk/client-bedrock-runtime": ">=3.864.0 <4",
    "@google/genai": ">=2.22.0 <3",
    "@jitl/quickjs-singlefile-cjs-release-sync": ">=0.32.0 <0.33",
    "better-sqlite3": ">=11.10.0 <12",
    "chokidar": ">=4 <5",
    "dotenv": ">=16 <17",
    "esbuild": ">=0.25 <0.26",
    "quickjs-emscripten-core": ">=0.32.0 <0.33"
  },
  "peerDependenciesMeta": {
    "@orchajs/playground-ui": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@jitl/quickjs-singlefile-cjs-release-sync": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "chokidar": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "quickjs-emscripten-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.967.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@google/genai": "2.22.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@types/node": "18.19.130",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@xyflow/react": "^12.11.6",
    "baseui": "^16.1.1",
    "better-sqlite3": "11.10.0",
    "chokidar": "4.0.3",
    "dotenv": "16.6.1",
    "esbuild": "^0.25.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "quickjs-emscripten-core": "0.32.0",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "@aws-sdk/util-locate-window": "3.965.0",
    "fast-xml-parser": "5.11.2",
    "@changesets/write": {
      "human-id": "4.1.1"
    }
  }
}
